{
  "phases": [
    {"name": "nothing wrong, long enough to learn the normal (5 healthy minutes)", "cmd": "none", "observe": 460,
     "asserts": [{"name": "healthy", "path": ".doctor.status", "match": "^healthy$"},
                 {"name": "exit 0", "path": ".doctor.exit_code", "match": "^0$"}]},
    {"name": "15% packet loss on the link", "cmd": "loss", "key": "same", "observe": 30,
     "asserts": [{"name": "noticed", "path": "[.doctor.analysis.findings[]?|.cause]|join(\",\")", "match": "gateway|link|internet|degraded"},
                 {"name": "gateway flagged", "path": "[.doctor.analysis.ladder[]|select(.area==\"gateway\")|.status][0]", "match": "warn|bad"}]},
    {"name": "250 ms added to everything", "cmd": "latency", "key": "same", "observe": 30,
     "asserts": [{"name": "noticed", "path": "[.doctor.analysis.findings[]?|.cause]|join(\",\")", "match": "gateway|link|internet|degraded"},
                 {"name": "gateway flagged", "path": "[.doctor.analysis.ladder[]|select(.area==\"gateway\")|.status][0]", "match": "warn|bad"}]},
    {"name": "DNS dropped, everything else fine", "cmd": "dns", "key": "same",
     "asserts": [{"name": "noticed", "path": ".doctor.status", "match": "^(problems|degraded|down)"},
                 {"name": "cause", "path": "[.doctor.analysis.findings[]?|select(.severity!=\"info\")|.cause]|join(\",\")", "match": "dns"}]},
    {"name": "web (80/443) rejected, ping and DNS fine", "cmd": "web", "key": "same",
     "asserts": [{"name": "noticed", "path": ".doctor.status", "match": "^(problems|degraded|down)"},
                 {"name": "cause", "path": "[.doctor.analysis.findings[]?|select(.severity!=\"info\")|.cause]|join(\",\")", "match": "http-blocked|web"}]},
    {"name": "outbound ICMP dropped, TCP and DNS fine", "cmd": "no-icmp", "key": "same",
     "asserts": [{"name": "not called down", "path": ".doctor.status", "match": "^(healthy|problems|degraded)$"},
                 {"name": "web still ok", "path": ".doctor.http.v4.status", "match": "^ok$"}]},
    {"name": "nothing leaves the LAN", "cmd": "no-internet", "key": "same",
     "asserts": [{"name": "noticed", "path": ".doctor.status", "match": "^(down|problems)"},
                 {"name": "exit non-zero", "path": ".doctor.exit_code", "match": "^[1-9]"},
                 {"name": "cause", "path": "[.doctor.analysis.findings[]?|select(.severity!=\"info\")|.cause]|join(\",\")", "match": "isp|internet|dns"}]},
    {"name": "captive portal answers every HTTP request", "cmd": "captive", "key": "same",
     "asserts": [{"name": "noticed", "path": ".doctor.status", "match": "^(problems|degraded|down)"},
                 {"name": "cause", "path": "[.doctor.analysis.findings[]?|select(.severity!=\"info\")|.cause]|join(\",\")", "match": "captive"}]}
  ]
}
